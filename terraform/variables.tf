variable "aws_region" {
  description = "AWS region for the Lambda deployment."
  type        = string
  default     = "us-east-1"
}

variable "project_name" {
  description = "Project name used in resource naming."
  type        = string
  default     = "car-repair-auth-lambda"
}

variable "environment" {
  description = "Deployment environment name."
  type        = string
  default     = "dev"
}

variable "lambda_package_path" {
  description = "Path to the Lambda zip package generated by the build pipeline."
  type        = string
  default     = "./artifacts/lambda.zip"
}

variable "lambda_handler" {
  description = "Lambda handler entrypoint."
  type        = string
  default     = "CarRepair.Auth.Lambda::CarRepair.Auth.Lambda.Function::FunctionHandler"
}

variable "lambda_memory_size" {
  description = "Lambda memory size in MB."
  type        = number
  default     = 256
}

variable "lambda_timeout" {
  description = "Lambda timeout in seconds."
  type        = number
  default     = 15
}

variable "postgres_secret_id" {
  description = "Name or ARN of the existing Secrets Manager secret that stores the PostgreSQL connection string."
  type        = string
  default     = "car-repair/auth/postgres"
}

variable "jwt_secret_name" {
  description = "Secrets Manager secret name for the JWT signing key managed by this stack."
  type        = string
  default     = "car-repair/auth/jwt"
}

variable "jwt_issuer" {
  description = "JWT issuer claim."
  type        = string
  default     = "car-repair-auth"
}

variable "jwt_audience" {
  description = "JWT audience claim."
  type        = string
  default     = "car-repair-shop"
}

variable "jwt_expiration_in_minutes" {
  description = "JWT expiration time in minutes."
  type        = number
  default     = 60
}

variable "db_schema" {
  description = "Database schema that contains the customers table."
  type        = string
  default     = "public"
}

variable "customers_table_name" {
  description = "Customers table name in PostgreSQL."
  type        = string
  default     = "customers"
}

variable "enable_api_gateway" {
  description = "Whether API Gateway resources should be created (disable when ingress is handled by Kong in production)."
  type        = bool
  default     = true
}

variable "tags" {
  description = "Additional tags applied to AWS resources."
  type        = map(string)
  default     = {}
}
